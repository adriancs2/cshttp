<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Multi-targeting: supports .NET Framework 4.8 and modern .NET 8 / 10 -->
    <TargetFrameworks>net8.0;net10.0;net48</TargetFrameworks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- When compiling for .NET Framework 4.8 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="cshttp">
      <HintPath>lib\net48\cshttp.dll</HintPath>
    </Reference>
    <Reference Include="cshttp.web">
      <HintPath>lib\net48\cshttp.web.dll</HintPath>
    </Reference>
    <Reference Include="cshttp.server">
      <HintPath>lib\net48\cshttp.server.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- When compiling for modern .NET (8.0, 9.0, 10.0+) -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <Reference Include="cshttp">
      <HintPath>lib\net8.0\cshttp.dll</HintPath>
    </Reference>
    <Reference Include="cshttp.web">
      <HintPath>lib\net8.0\cshttp.web.dll</HintPath>
    </Reference>
    <Reference Include="cshttp.server">
      <HintPath>lib\net8.0\cshttp.server.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
