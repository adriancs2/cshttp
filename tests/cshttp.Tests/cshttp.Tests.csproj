<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Zero-dependency test harness. Runs every test on both runtimes:
      dotnet run -f net10.0
      dotnet run -f net48
    Optional argument: a substring filter on test names.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <AssemblyName>cshttp.Tests</AssemblyName>
    <RootNamespace>cshttp.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\cshttp\cshttp.csproj" />
  </ItemGroup>
</Project>