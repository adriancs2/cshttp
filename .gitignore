# Visual Studio / build output
.vs/
bin/
obj/
packages/
*.user
*.suo

# ---------------------------------------------------------------------------
# App_Data: commit only the skeleton, never runtime data.
#   kept:    config.sample.json, readme.txt, public/web.config, public/App_Data/.gitkeep
#   ignored: config.json (API key, password hashes), sessions, recycle bin, undo, tmp,
#            and every website file / database inside public/
# ---------------------------------------------------------------------------
tests/test-hearth-file-manager/App_Data/*
!tests/test-hearth-file-manager/App_Data/config.sample.json
!tests/test-hearth-file-manager/App_Data/readme.txt
!tests/test-hearth-file-manager/App_Data/public/

tests/test-hearth-file-manager/App_Data/public/*
!tests/test-hearth-file-manager/App_Data/public/web.config
!tests/test-hearth-file-manager/App_Data/public/App_Data/

tests/test-hearth-file-manager/App_Data/public/App_Data/*
!tests/test-hearth-file-manager/App_Data/public/App_Data/.gitkeep

tests/test-hearth-file-manager/App_Data/recycle-bin/
tests/test-hearth-file-manager/HearthFileManager/App_Data/recycle-bin/
tests/test-hearth-file-manager/HearthFileManager/App_Data/config.json
tests/test-hearth-file-manager/HearthFileManager/App_Data/sessions.json
tests/test-hearth-file-manager/HearthFileManager/App_Data/recycle-index.json

# PowerShell test sandbox
tests/sandbox/
